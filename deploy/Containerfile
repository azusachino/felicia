# Stage 1: Build the Go binary
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Copy workspace and dependency manifests
COPY go.work go.work.sum ./
COPY core/go.mod core/go.sum core/
COPY runtime/go.mod runtime/go.sum runtime/
COPY providers/go.mod providers/go.sum providers/
COPY server/go.mod server/go.sum server/
COPY publication/go.mod publication/go.sum publication/
COPY cli/go.mod cli/go.sum cli/
RUN for module in core runtime providers publication server cli; do cd "$module" && go mod download && cd /app; done

# Copy source code
COPY . .

# Build statically compiled binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/felicia-api ./server/cmd/api

# Stage 2: Runtime container
FROM alpine:latest

# Install CA certificates for HTTPS requests to Immich/Dawarich APIs
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy the compiled binary from builder stage
COPY --from=builder /app/felicia-api /app/felicia-api

EXPOSE 8080

ENTRYPOINT ["/app/felicia-api"]
