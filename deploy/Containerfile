# Stage 1: Build the Go binary
FROM golang:1.26-alpine AS builder

WORKDIR /app

# Copy workspace and dependency manifests
COPY go.work go.work.sum ./
COPY apps/core/go.mod apps/core/go.sum apps/core/
COPY apps/runtime/go.mod apps/runtime/go.sum apps/runtime/
COPY apps/providers/go.mod apps/providers/go.sum apps/providers/
COPY apps/apiserver/go.mod apps/apiserver/go.sum apps/apiserver/
RUN for module in apps/core apps/runtime apps/providers apps/apiserver; do cd "$module" && go mod download && cd /app; done

# Copy source code
COPY . .

# Build statically compiled binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/felicia-api ./apps/apiserver/cmd/api

# Stage 2: Runtime container
FROM alpine:latest

# Install CA certificates for HTTPS requests to Immich/Dawarich APIs
RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy the compiled binary from builder stage
COPY --from=builder /app/felicia-api /app/felicia-api

EXPOSE 8080

ENTRYPOINT ["/app/felicia-api"]
