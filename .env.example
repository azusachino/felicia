# Copy to .env and source it (or use `set -x` in fish) for local dev.
# Matches deploy/compose.yaml (postgis/postgis:18 + valkey/valkey:9).

# Postgres 18 + PostGIS — used by the API server, `make migrate`, `make seed`,
# and the DSN-gated integration tests in providers/postgres.
DATABASE_DSN=postgres://postgres:password@localhost:5432/felicia?sslmode=disable

# API server listen port (server/cmd/api). Defaults internally if unset.
PORT=8080

# Disposable PostgreSQL database used only by destructive integration tests.
# Keep this separate from the runtime DATABASE_DSN.
FELICIA_TEST_DATABASE_DSN=postgres://postgres:password@localhost:5432/felicia?sslmode=disable

# Valkey (Redis-compatible) cache address (host:port). Empty disables caching.
CACHE_ADDR=localhost:6379

# Optional ingest sources. FELICIA_* takes precedence over the unprefixed
# variables retained for existing local scripts and the mock workflow.
FELICIA_DAWARICH_URL=
FELICIA_DAWARICH_API_KEY=
FELICIA_IMMICH_URL=
FELICIA_IMMICH_API_KEY=

# Route-curation defaults. Tune these only when a source or route needs it.
FELICIA_RDP_EPSILON=0.0001
FELICIA_TRANSIT_SEGMENT_LENGTH_M=100000
