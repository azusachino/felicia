# Go
/bin/
node_modules/
dist/
vendor/
*.test
*.out
coverage.*

# Env / secrets
.env
.env.*
!.env.example

# Local data / object-store scratch
/tmp/
/design/
.felicia/
# The authored journal is the one thing ADR-0025 says never leaves the machine,
# so every SQLite spelling the tooling can produce is ignored — `make dev`
# still defaults DATABASE_PATH to felicia.db at the repo root.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm

# Docs (mkdocs build output + uv env; uv.lock is committed)
/site/
.venv/
__pycache__/
*.py[cod]

# Real trip inputs used to exercise the pipeline. Personal data: photos, GPS
# tracks, and location history never belong in the repository.
/test_trip/

# OS / editor
.DS_Store
*.swp

# Admin GUI E2E (ADMIN-01.8, Playwright)
/apps/felicia-web/playwright-report/
/apps/felicia-web/test-results/

# Agent session scratch (asobi is canonical; these are fallback only)
.agents/CONTEXT.md
.agents/CURRENT_TASK.md
.agents/MEMORY.md

# Asobi project-local database
/.asobi/
/apps/felicia-cli/felicia
/scripts/_admin_preview.py
