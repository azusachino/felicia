# Auto-load local dev env (DATABASE_DSN, PORT, CACHE_ADDR) so `make migrate`,
# `make seed`, and the DSN-gated integration tests just work without exporting
# anything by hand. Values live in .env (gitignored) — copy .env.example to .env.
# Run `direnv allow` once to trust this file.
dotenv_if_exists .env

# Optional: auto-enter the nix devShell on cd (needs nix-direnv). Uncomment to use.
# use flake
