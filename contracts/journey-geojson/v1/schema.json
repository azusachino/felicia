{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/azusachino/felicia/contracts/journey-geojson/v1/schema.json",
  "title": "Felicia published journey GeoJSON contract v1",
  "description": "Sanitized, published-only GeoJSON FeatureCollection export for external sites (Decision D4, D15).",
  "type": "object",
  "required": ["type", "schema", "generator", "properties", "features"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "const": "FeatureCollection"
    },
    "schema": {
      "type": "string",
      "const": "felicia.journey.geojson.v1"
    },
    "generator": {
      "type": "string",
      "minLength": 1
    },
    "properties": {
      "type": "object",
      "required": ["slug", "title", "place", "country", "region", "date_start", "date_end"],
      "additionalProperties": false,
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 1 },
        "place": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "date_start": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "date_end": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["day", "date", "title"],
            "additionalProperties": false,
            "properties": {
              "day": { "type": "integer", "minimum": 1 },
              "date": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      }
    }
  },
  "$defs": {
    "feature": {
      "type": "object",
      "required": ["type", "properties", "geometry"],
      "properties": {
        "type": { "type": "string", "const": "Feature" },
        "id": { "type": "string" },
        "properties": {
          "type": "object",
          "required": ["role"],
          "properties": {
            "role": { "enum": ["route", "stop", "memento"] }
          }
        },
        "geometry": {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "enum": ["Point", "LineString", "MultiLineString"] },
            "coordinates": { "type": "array" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "properties": { "properties": { "role": { "const": "route" } } }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "type": "object",
                "properties": {
                  "type": { "enum": ["LineString", "MultiLineString"] }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "properties": { "properties": { "role": { "const": "stop" } } }
            }
          },
          "then": {
            "required": ["id"],
            "properties": {
              "geometry": {
                "type": "object",
                "properties": {
                  "type": { "const": "Point" }
                }
              },
              "properties": {
                "required": ["role", "label", "arrive", "depart"],
                "properties": {
                  "label": { "type": "string" },
                  "arrive": { "type": "string" },
                  "depart": { "type": "string" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "properties": { "properties": { "role": { "const": "memento" } } }
            }
          },
          "then": {
            "required": ["id"],
            "properties": {
              "geometry": {
                "type": "object",
                "properties": {
                  "type": { "const": "Point" }
                }
              },
              "properties": {
                "required": ["role", "stop_key", "seq", "kind", "occurred_at", "occurred_tz", "title", "place", "essay", "media"],
                "properties": {
                  "stop_key": { "type": "string", "minLength": 1 },
                  "seq": { "type": "integer", "minimum": 1 },
                  "kind": { "type": "string", "minLength": 1 },
                  "occurred_at": { "type": "string" },
                  "occurred_tz": { "type": "string", "minLength": 1 },
                  "title": { "type": "string", "minLength": 1 },
                  "place": { "type": "string" },
                  "essay": { "type": "string" },
                  "kind_data": { "type": "object" },
                  "media": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["immich_asset_id"],
                      "properties": {
                        "immich_asset_id": { "type": "string", "minLength": 1 },
                        "caption": { "type": "string" },
                        "seq": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
