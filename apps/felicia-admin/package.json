{
  "name": "@felicia/admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.e2e.json && eslint . && prettier --check . && bun run test",
    "test": "bun --bun ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts apps/felicia-admin/src",
    "e2e": "playwright test --config playwright.desktop.config.ts",
    "e2e:install": "playwright install chromium webkit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "svelte": "^5.56.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lucide/svelte": "1.51.0",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "bits-ui": "^2.18.0",
    "@internationalized/date": "3.12.4",
    "cn": "0.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "mode-watcher": "1.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6"
  }
}
