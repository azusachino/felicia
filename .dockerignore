# Keep the API build context to the Go workspace. Without this, `COPY . .` in
# ops/Containerfile pulls in worktrees, node_modules, and build output —
# ~900MB of context that never reaches the compiled binary.
.claude/
.git/
node_modules/
**/node_modules/
dist/
**/dist/
site/
bin/
.venv/
**/__pycache__/
**/.svelte-kit/
**/.playwright/
# Local secrets never enter the build context. Keep .env.example tracked.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
docs/
experiments/
examples/
